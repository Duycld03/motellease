# Copy to .env and fill in. Read by docker compose only — the backend's own configuration lives
# in appsettings.Development.json and user-secrets, not here.

# Overrides the development default in docker-compose.yml.
POSTGRES_PASSWORD=devonly_change_me

# pgAdmin, started with: docker compose --profile tools up -d
PGADMIN_PASSWORD=devonly_change_me

# Only needed to receive a payment gateway's IPN callback locally, and only with the "tunnel"
# profile. Both values come from the ngrok dashboard; the free plan assigns one stable dev domain.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-assigned-domain.ngrok-free.app
