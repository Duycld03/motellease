{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "motellease",
    "Audience": "motellease-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "LifetimeMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "VerifiedEmailWindowMinutes": 30
  },
  "RateLimiting": {
    "Authentication": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Otp": { "PermitLimit": 5, "WindowSeconds": 300 }
  },
  "Smtp": {
    "Port": 587,
    "UseStartTls": true,
    "FromName": "MotelLease"
  },
  "Cloudinary": {
    "RootFolder": "MotelLease"
  },
  "GoogleAuth": {},
  "App": {
    "ApiBaseUrl": "http://localhost:5000",
    "WebBaseUrl": "http://localhost:3000"
  },
  "VnPay": {
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
  },
  "MoMo": {
    "CreateUrl": "https://test-payment.momo.vn/v2/gateway/api/create",
    "RequestType": "captureWallet"
  }
}
